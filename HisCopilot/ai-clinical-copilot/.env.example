# =============================================================================
# .env.example — AI Clinical Copilot
# 复制为 .env 并按实际填写。所有值可被 infra/models.yaml + 环境变量覆盖。
# =============================================================================

APP_ENV=development
APP_NAME=ai-clinical-copilot
APP_PORT=8001
FRONTEND_PORT=3000

# ---- 隔离 conda env（host process 模式） ----
CONDA_ENV_MAIN=hiscopilot
CONDA_ENV_TCM=hiscopilot-tcm
MODELS_ROOT=/home/ma-user/modelarts/user-job-dir/yujc/HisCopilot/models

# ---- DB（MVP 用 SQLite；未来切 Postgres+pgvector）----
DATABASE_URL=sqlite+aiosqlite:///./data/ai_clinical.db
# DATABASE_URL=postgresql+asyncpg://ai_clinical:change-me@localhost:5432/ai_clinical

# ---- Cache（MVP 用进程内；未来切 Redis）----
CACHE_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# ---- Object Store（MVP 用本地文件；未来切 MinIO）----
OBJECT_STORE_BACKEND=local
OBJECT_STORE_DIR=./data/objects
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me

# ---- 模型权重路径（相对 MODELS_ROOT，留空则用 models.yaml 默认） ----
MODEL_QWEN_PATH=Qwen3.8-27B
MODEL_SHIZHEN_PATH=ShizhenGPT-7B-Omni
MODEL_ASR_PATH=Qwen3-ASR-1.7B
MODEL_EMBEDDING_PATH=Qwen3-Embedding-8B
MODEL_RERANKER_PATH=Qwen3-Reranker-8B
MODEL_OCR_PATH=PaddleOCR-VL-1.6

# ---- Model Gateway（OpenAI-compatible）----
MODEL_GATEWAY_URL=http://127.0.0.1:7860/v1
QWEN_BASE_URL=http://127.0.0.1:7870/v1
SHIZHEN_BASE_URL=http://127.0.0.1:7871/v1
ASR_BASE_URL=http://127.0.0.1:7872/v1
EMBEDDING_BASE_URL=http://127.0.0.1:7873/v1
RERANKER_BASE_URL=http://127.0.0.1:7874/v1
OCR_BASE_URL=http://127.0.0.1:7875/v1

# ---- 开关 ----
ENABLE_SECOND_OPINION=false
ENABLE_REAL_HIS=false
ENABLE_AI_FAILURE_SIMULATION=false
NO_EXTERNAL_LLM=true

# ---- GPU ----
CUDA_VISIBLE_DEVICES=1

# ---- Auth（MVP，JWT）----
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Logging ----
LOG_LEVEL=INFO
